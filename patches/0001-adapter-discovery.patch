+    std::string DBusService::ResolveAdapterPath(sdbus::IProxy& rootProxy) {
+        // Permet de forcer un adaptateur precis : MAGICPODS_ADAPTER=hci1
+        // ou MAGICPODS_ADAPTER=/org/bluez/hci1
+        if (const char* forced = std::getenv("MAGICPODS_ADAPTER")) {
+            std::string value{forced};
+            if (!value.empty()) {
+                if (value.rfind("/org/bluez/", 0) != 0)
+                    value = "/org/bluez/" + value;
+                Logger::Info("Adapter forced by MAGICPODS_ADAPTER: %s", value.c_str());
+                return value;
+            }
+        }
+
+        std::map<sdbus::ObjectPath, std::map<std::string, std::map<std::string, sdbus::Variant>>> managedObjects{};
+
+        try {
+            rootProxy.callMethod("GetManagedObjects")
+                .onInterface("org.freedesktop.DBus.ObjectManager")
+                .storeResultsTo<std::map<sdbus::ObjectPath, std::map<std::string, std::map<std::string, sdbus::Variant>>>>(managedObjects);
+        }
+        catch (const sdbus::Error& error) {
+            Logger::Error("Failed to enumerate BlueZ objects: %s", error.getMessage().c_str());
+            return std::string{};
+        }
+
+        std::string firstAdapter{};
+
+        for (const auto& [objectPath, interfaces] : managedObjects) {
+            const auto adapterInterface = interfaces.find("org.bluez.Adapter1");
+            if (adapterInterface == interfaces.end())
+                continue;
+
+            if (firstAdapter.empty())
+                firstAdapter = objectPath;
+
+            const auto powered = adapterInterface->second.find("Powered");
+            if (powered != adapterInterface->second.end() && powered->second.get<bool>()) {
+                Logger::Info("Using powered Bluetooth adapter: %s", std::string{objectPath}.c_str());
+                return objectPath;
+            }
+        }
+
+        if (!firstAdapter.empty())
+            Logger::Info("No powered adapter found, falling back to: %s", firstAdapter.c_str());
+        else
+            Logger::Error("No org.bluez.Adapter1 object found");
+
+        return firstAdapter;
+    }
